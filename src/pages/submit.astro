---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Submit Product — Event Horizon">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Submit signal</span>
      <h1>Bring your product to the horizon.</h1>
      <p>First version uses an external form. Replace the placeholder with Feishu, Tally, Typeform, or Tencent Form once the submission fields are finalized.</p>
      <div class="hero-actions">
        <a class="button" href="https://example.com/submit" target="_blank" rel="noreferrer">Open submission form</a>
        <a class="button secondary" href="/projects">View project format</a>
      </div>
    </div>
  </section>
  <section class="section compact">
    <div class="container grid-3">
      <div class="card"><div class="kicker">01</div><h3>Project card</h3><p>Name, one-liner, target user, stage, AI stack, product URL, current needs.</p></div>
      <div class="card"><div class="kicker">02</div><h3>Authorization</h3><p>Choose what is public, community-only, or investor-only before publication.</p></div>
      <div class="card"><div class="kicker">03</div><h3>Product Drop</h3><p>Approved projects enter the weekly drop with a concrete signal and next milestone.</p></div>
    </div>
  </section>
</BaseLayout>
