<script>
  import { gsap } from 'gsap';

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      finePointer: '(pointer: fine)',
    },
    (context) => {
      const { reduceMotion, finePointer } = context.conditions ?? {};

      gsap.defaults({ ease: 'power3.out', duration: reduceMotion ? 0 : 0.8 });

      if (!reduceMotion) {
        gsap.from('.site-header', { y: -18, autoAlpha: 0, duration: 0.6 });
        gsap.from('.hero-copy > *', {
          y: 22,
          autoAlpha: 0,
          stagger: 0.08,
          duration: 0.75,
          delay: 0.08,
        });
        gsap.from('.horizon-visual', {
          scale: 0.94,
          autoAlpha: 0,
          duration: 1.05,
          delay: 0.14,
          ease: 'power2.out',
        });
        gsap.from('.system-map, .project-card, .drop-panel, .icon-card', {
          y: 18,
          autoAlpha: 0,
          stagger: 0.055,
          duration: 0.72,
          delay: 0.22,
        });
      }

      gsap.to('.orbit-dot', {
        x: (index) => [14, -10, 8, -13, 11][index] ?? 8,
        y: (index) => [-12, 10, -8, 9, -11][index] ?? -8,
        scale: (index) => [1.12, 0.92, 1.08, 1, 1.2][index] ?? 1,
        duration: reduceMotion ? 0 : 3.2,
        repeat: reduceMotion ? 0 : -1,
        yoyo: true,
        stagger: 0.18,
        ease: 'sine.inOut',
      });

      gsap.to('.horizon-visual', {
        rotation: finePointer && !reduceMotion ? 0.6 : 0,
        duration: 6,
        repeat: reduceMotion ? 0 : -1,
        yoyo: true,
        ease: 'sine.inOut',
        transformOrigin: '50% 50%',
      });
    }
  );
</script>
