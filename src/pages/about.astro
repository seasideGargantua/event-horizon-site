---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="About — Event Horizon">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Why Event Horizon</span>
      <h1>AI is the boundary. Builders cross first.</h1>
      <p>Event Horizon is for people who believe AI is not merely a tool upgrade, but a phase shift in individual capability, product formation, and capital discovery.</p>
    </div>
  </section>
  <section class="section compact">
    <div class="container grid-3">
      <div class="card"><div class="kicker">Mission</div><h3>Fair visibility</h3><p>Give serious early products a first layer of visibility based on updates and evidence.</p></div>
      <div class="card"><div class="kicker">Network</div><h3>Superindividuals</h3><p>Connect builders, operators, designers, researchers, users, investors, and resource partners.</p></div>
      <div class="card"><div class="kicker">Boundary</div><h3>Transparent signals</h3><p>Separate public proof from private claims, and publish only authorized project information.</p></div>
    </div>
  </section>
</BaseLayout>
